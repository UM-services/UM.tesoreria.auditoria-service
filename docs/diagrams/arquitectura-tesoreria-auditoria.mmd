        Mapper["AuditEventMapper<br/>+ AuditPayloadHasher"]
        Repo["IAuditEventRepository"]
        KafkaTopics["KafkaTopicsConfiguration<br/>DLT"]
    end

    subgraph Infra["Infraestructura"]
        MySQL["MySQL<br/>tesium_aud.audit_event"]
        Kafka["Kafka<br/>tesoreria-audit-evento.DLT"]
        Consul["Consul<br/>tesoreria-auditoria-service"]
        Actuator["Actuator<br/>/actuator/health/readiness"]
    end

    Client --> Filter
    Client --> Security
    Filter --> Controller
    Security --> Controller
    Controller --> Svc
    Svc --> Mapper
    Svc --> Repo
