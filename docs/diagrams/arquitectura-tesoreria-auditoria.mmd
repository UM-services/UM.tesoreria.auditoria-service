flowchart TB
    Client["Emisores<br/>core / mercadopago / guarani"]

    subgraph Service["um.tesoreria.auditoria-service"]
        Filter["AuditApiKeyFilter<br/>X-API-Key"]
        Security["Spring Security"]
        Controller["AuditEventController"]
